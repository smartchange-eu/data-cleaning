# moderate & vigorous pa – minutes/day → hours/week
def minutes_day_to_hours_week(val):
    if pd.isnull(val) or str(val).strip() == "":
        return np.nan
    v = str(val).strip().lower()
    if "do not know" in v:
        return np.nan
    num = pd.to_numeric(val, errors="coerce")
    if pd.isnull(num):
        return np.nan
    return round(num * 7.0 / 60.0, 2)

for tp in timepoints_04:
# moderate
    col = f"p894_{tp}"
    if col in df.columns:
        df[f"moderate_act_{tp}"] = df[col].apply(minutes_day_to_hours_week)
    else:
        df[f"moderate_act_{tp}"] = np.nan

# vigorous
    col = f"p914_{tp}"
    if col in df.columns:
        df[f"vigorous_act_{tp}"] = df[col].apply(minutes_day_to_hours_week)
    else:
        df[f"vigorous_act_{tp}"] = np.nan

    df[f"mvpa_{tp}"] = (
        pd.to_numeric(df[f"moderate_act_{tp}"], errors="coerce") +
        pd.to_numeric(df[f"vigorous_act_{tp}"], errors="coerce")
    ).round(2)

